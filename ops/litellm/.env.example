# LiteLLM proxy environment — copy to ops/litellm/.env and fill in.
# .env is gitignored; .env.example is committed for reference.

# Backend API keys (passed through to provider-specific endpoints)
DEEPSEEK_API_KEY=sk-replace-with-real-deepseek-key
GLM_API_KEY=replace-with-real-glm-key

# Master key the proxy requires on every request.
# Generate with: openssl rand -hex 32, then prefix with sk- (no spaces).
# stage_runner will send this as ANTHROPIC_AUTH_TOKEN for non-anthropic stages.
LITELLM_MASTER_KEY=sk-litellm-CHANGE-ME-32-hex-chars

# LiteLLM internal — keep as-is unless you know what you are doing.
LITELLM_LOG=INFO
