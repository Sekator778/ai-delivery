# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Numeric Telegram user ID of the bot owner
OWNER_TELEGRAM_ID=

# Display name used in the [FROM <name>] prompt prefix
OWNER_NAME=

# JSON-encoded multi-user registry (overrides OWNER_TELEGRAM_ID/OWNER_NAME if set)
# Example: [{"id": 123, "name": "Alex"}, {"id": 456, "name": "Maria"}]
BOT_USERS_JSON=

# Override path to claude CLI if not on PATH
CLAUDE_BIN=claude

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Root directory holding projects the meta-agent can delegate into
DEFAULT_PROJECT_DIR=

# Absolute path to the default target repo when /task is called without @alias.
# Used as fallback in bot/bot.py. If unset, /task without @alias surfaces an
# error to the user instead of writing somewhere unexpected.
# Multi-repo routing: use bot/projects.json (gitignored) — see bot/projects.example.json.
BOT_DEFAULT_TARGET_REPO=

# Enable Claude Code Agent Teams (experimental, v2.1.32+). Required for
# the M5 7-role pipeline (BA -> Architect -> Developer -> Tester ->
# Security -> Reviewer) where meta-agent spawns parallel teammate sessions
# via the agents/ definitions in meta/.claude/agents/. Set to 1 to enable.
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# --- Sub-Claude backend (DeepSeek-routed by run_subtask in bot.py) ---
# When DEEPSEEK_API_KEY is set, every sub-Claude spawned via
# /run-in-project gets these env vars in its subprocess, routing the
# `claude` CLI to DeepSeek's Anthropic-compatible endpoint instead of
# Claude Max. Meta-agent (run_meta_claude) is untouched — it stays on
# Max via OAuth. See ARCHITECTURE.md §8.1 for the tiering rationale.
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL_PRIMARY=deepseek-v4-pro
DEEPSEEK_MODEL_SONNET=deepseek-v4-pro
DEEPSEEK_MODEL_HAIKU=deepseek-v4-flash
DEEPSEEK_MODEL_SUBAGENT=deepseek-v4-flash

# --- GLM-5.1 (Z.ai / Zhipu) — third backend after Anthropic, DeepSeek ---
# When rate-limit hits on the current backend, the /rl_switch Telegram
# button rotates through {anthropic, deepseek, glm} minus the current
# one. To enable GLM as an option, set GLM_API_KEY (from z.ai console).
# stage_runner falls back to anthropic with a warning if GLM_API_KEY is
# empty, so it's safe to leave unset until you actually want GLM.
GLM_API_KEY=
GLM_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
GLM_MODEL_PRIMARY=glm-4.6
GLM_MODEL_SONNET=glm-4.6
GLM_MODEL_HAIKU=glm-4.5-flash
GLM_MODEL_SUBAGENT=glm-4.5-flash

# --- /memo + /recall — semantic long-term memory (Qdrant + FastEmbed) ---
# Qdrant runs locally via services/stacks/mem0/docker-compose.yml.
# FastEmbed (ONNX Runtime, no GPU) downloads ~2 GB on first /memo use.
# Default: intfloat/multilingual-e5-large — SOTA multilingual (RU+EN) with
# strong recall (~0.8 cosine on cross-lingual queries in smoke test).
# Swap to sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# (dim=384, ~120 MB) if disk-constrained — at the cost of weaker recall.
MEMO_QDRANT_URL=http://127.0.0.1:6333
MEMO_COLLECTION=meta_agent_mem
MEMO_EMBED_MODEL=intfloat/multilingual-e5-large
MEMO_EMBED_DIMS=1024

# --- LangSmith tracing (Block 2.3 — observability) ---
# Set CC_LANGSMITH_API_KEY (from smith.langchain.com → Settings → API Keys)
# to light up per-stage traces. stage_runner exports CC_LANGSMITH_METADATA
# with {pipeline, stage, task_id, backend} per claude invocation; with the
# langsmith-tracing plugin installed (via `claude plugin install
# langsmith-tracing@langsmith-claude-code-plugins`) traces appear under
# the project named in LANGSMITH_PROJECT.
CC_LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-delivery

# --- LiteLLM proxy — opt-in routing for non-anthropic backends ---
# When set, deepseek and glm stages route through the LiteLLM proxy
# instead of hitting providers directly. Leave UNSET for direct routing.
# To enable: bring up ops/litellm/docker-compose.yml, then set both vars:
# LITELLM_PROXY_URL=http://localhost:4000/v1
# LITELLM_MASTER_KEY=<same value as in ops/litellm/.env>
LITELLM_PROXY_URL=
LITELLM_MASTER_KEY=

# --- /stt — speech-to-text transcript file output (FR-018) ---
# Directory where the bot writes .txt transcript files (auto-created if absent).
# Must be a path writable by the bot process. Tilde is expanded.
STT_OUTPUT_DIR=~/Downloads/transcripts
# Maximum download size for audio files fetched by URL (in MB). Downloads that
# exceed this limit are aborted mid-stream — no transcript is produced.
STT_URL_MAX_MB=100
# Timeout for the whisper-cli transcription step inside the whisper-server
# container (seconds). Set identically in bot/.env and docker-compose.yml so the
# bot's HTTP client timeout (FFMPEG_TIMEOUT_SEC + WHISPER_TIMEOUT_SEC + 30)
# always outlasts the server-side budget.
WHISPER_TIMEOUT_SEC=600
# Timeout for the ffmpeg audio-conversion step inside the whisper-server
# container (seconds). Configured independently of WHISPER_TIMEOUT_SEC — the
# two timeouts govern separate subprocesses and must never be derived from
# each other (BRD NFR-003).
FFMPEG_TIMEOUT_SEC=60
