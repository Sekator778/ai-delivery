# Secrets — NEVER in git
.secrets/
.env
.env.local
.env.*.local
**/.env
!.env.example
**/secrets/
*.pem
*.key
*credentials*
*.token

# Agent logs and sessions
*.log
.sessions/

# ops/atlas/aidstack.sh runtime state (pidfiles + rotated daemon logs)
/.pids/
/logs/

